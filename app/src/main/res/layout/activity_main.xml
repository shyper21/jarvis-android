<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05030f">

    <!-- Main WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Offline View -->
    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#05030f"
        android:padding="32dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_jarvis"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="#c4b5fd"
            android:textSize="22sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_message"
            android:textColor="#7c3aed"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="160dp"
            android:layout_height="48dp"
            android:text="@string/retry"
            android:layout_marginTop="36dp"
            android:backgroundTint="#7c3aed"
            android:textColor="#ffffff"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Mic Toggle FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/micFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:contentDescription="Toggle microphone"
        android:elevation="6dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_mic"
        app:backgroundTint="#616161"
        app:tint="#ffffff" />

    <!-- Info / About Button -->
    <Button
        android:id="@+id/infoButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:text="i"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:elevation="4dp"
        android:visibility="gone" />

    <!-- Splash Overlay -->
    <LinearLayout
        android:id="@+id/splashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#05030f">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_jarvis"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#c4b5fd"
            android:textSize="34sp"
            android:letterSpacing="0.3"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_subtitle"
            android:textColor="#6d28d9"
            android:textSize="13sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="6dp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#7c3aed"
            android:layout_marginTop="52dp" />

    </LinearLayout>

</FrameLayout>
